# Shelby
# SHELBY_API_KEY is the Shelby *storage* key from your Shelby dashboard.
# A missing/invalid key makes uploads fall back to local-only storage (the
# blob never reaches the network and reads 404).
SHELBY_API_KEY=sk_shelby_your_api_key_here
# Note: https://rpc.shelby.xyz does NOT resolve. Leave unset (the code defaults
# to https://api.shelbynet.shelby.xyz/shelby) or set it explicitly here.
SHELBY_RPC_URL=https://api.shelbynet.shelby.xyz/shelby
SHELBY_NETWORK=shelbynet

# AI (free tier — get key at https://aistudio.google.com/apikey)
GOOGLE_AI_API_KEY=

# Database
DATABASE_URL=postgresql://verida:localpass@localhost:5432/verida_ai

# Redis
REDIS_URL=redis://localhost:6379

# Aptos
APTOS_NODE_URL=https://fullnode.testnet.aptoslabs.com
APTOS_NETWORK=testnet

# Marketplace Smart Contract
MARKETPLACE_CONTRACT_ADDRESS=0x141a8b5da194f039af93bdb7df81824a506fe73cade01138d2309aa7d497fddd
PLATFORM_TREASURY_ADDRESS=0x141a8b5da194f039af93bdb7df81824a506fe73cade01138d2309aa7d497fddd

# Escrow auto-release keeper
# Calls escrow::auto_release for pending escrows past the 7-day dispute window.
# Set to 'false' to disable; runs every ESCROW_KEEPER_INTERVAL_MS (min 60s, default 1h).
# Transactions (register_blob, escrow::auto_release) are signed with
# SHELBY_SIGNER_PRIVATE_KEY. It must be the private key of an account that
# exists on shelbynet and holds APT for gas — otherwise the upload runtime
# fails and every upload silently falls back to local-only storage.
SHELBY_SIGNER_PRIVATE_KEY=
ESCROW_KEEPER_ENABLED=true
ESCROW_KEEPER_INTERVAL_MS=3600000

# Frontend
VITE_MARKETPLACE_CONTRACT_ADDRESS=0x141a8b5da194f039af93bdb7df81824a506fe73cade01138d2309aa7d497fddd

# App
VITE_API_URL=http://localhost:4000
JWT_SECRET=change-me
